<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Connecting glowing link circles representing two students connecting -->
    <!-- Left Loop (Student A / Connection) -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 46,54 C 46,45 53,38 62,38 C 71,38 78,45 78,54 C 78,63 71,70 62,70">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46"
                android:startY="38"
                android:endX="78"
                android:endY="70"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#E0F2F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Loop (Student B / Connection) - Interlocking with Left Loop -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 62,54 C 62,45 55,38 46,38 C 37,38 30,45 30,54 C 30,63 37,70 46,70">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="38"
                android:endX="62"
                android:endY="70"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#B2DFDB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing network lines extending from loops to nodes -->
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#80FFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 30,54 L 20,54 M 78,54 L 88,54 M 46,38 L 46,26 M 62,70 L 62,82" />

    <!-- Connection Nodes (glowing dots) representing different users -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 20,54 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 88,54 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 46,26 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 62,82 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0" />
        
    <!-- Golden Link intersection accent (representing a match/spark!) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M 54,54 m -3.5,0 a 3.5,3.5 0 1,1 7,0 a 3.5,3.5 0 1,1 -7,0" />

</vector>